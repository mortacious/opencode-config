// OpenCode v2 (branch v2-port)
{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode-go/mimo-v2.6-flash",
  // Single entrypoint: the built-in build/plan primaries are disabled below.
  "default_agent": "orchestrator",
  "websearch": { "provider": "exa" },
  "experimental": { "subagent_depth": 2 },
  "plugins": [
    {
      "package": "opencode-dcp@2.0.5",
      "options": {
        "maxContextLimit": "80%",
        "nudgeFrequency": 5,
        "iterationNudgeThreshold": 12,
        "allowSubAgents": true
      }
    },
    "./plugin-src/fusion-audit",
    "./plugin-src/fusion-bootstrap",
    "./plugin-src/fusion-channel",
    "./plugin-src/profile-switcher",
    "./plugin-src/subagent-view",
    {
      "package": "./plugin-src/subagent-cap",
      "options": {
        "max": 0,
        "profiles": { "cheap-local": 3 }
      }
    }
  ],
  // lsp: dropped in v2 port - not a documented v2 top-level key
  // Local configuration/state/cache directories under ~ are readable; other
  // home paths fall through to the default ask effect (a permission request),
  // so user-data directories (Documents, Downloads, Pictures, Projects outside
  // the workspace) prompt instead of silently allowing. Standard system dirs
  // are allowed; anything unmatched (e.g. /var, /mnt) keeps the default ask
  // effect. Permissions evaluate findLast, so later rules win.
  "permissions": [
    { "action": "external_directory", "resource": "~/.config/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/**", "effect": "allow" },
    // Standard system directories.
    { "action": "external_directory", "resource": "/usr/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/lib/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/lib64/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/bin/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/sbin/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/etc/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/proc/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/sys/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/dev/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/run/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/snap/**", "effect": "allow" },
    // Defense-in-depth read denies: secrets stay blocked even inside allowed trees (global session rules evaluate last).
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/**", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/**", "effect": "deny" },
    { "action": "read", "resource": ".env*", "effect": "deny" },
    { "action": "read", "resource": "**/.env*", "effect": "deny" },
    // DCP `prune` tool: permissions evaluate findLast with session/global rules after agent rules, so this allow outranks agent tool denies.
    { "action": "prune", "resource": "*", "effect": "allow" },
    // Fusion channel tools: global/session rules evaluate last, so these allows work inside blanket-deny shells; the steer tool itself confines targets to direct children.
    { "action": "steer", "resource": "*", "effect": "allow" },
    { "action": "report", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false
      },
      "semantic-scholar": {
        "type": "local",
        "command": ["npx", "-y", "@xbghc/semanticscholar-mcp"],
        "environment": { "SEMANTIC_SCHOLAR_API_KEY": "{file:secrets/semantic_scholar_api_key}" },
        "disabled": false
      },
      "arxiv": {
        "type": "local",
        "command": ["npx", "-y", "@cyanheads/arxiv-mcp-server"],
        "disabled": false
      },
      "github": {
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/bin/github-mcp-server", "stdio", "--read-only", "--toolsets", "repos,issues,pull_requests,users"],
        "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:secrets/github_personal_access_token}" },
        "disabled": false
      },
      "dblp": {
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/.venv/bin/mcp-dblp"],
        "disabled": false
      },
      "ddgs": {
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/.venv-ddgs/bin/ddgs", "mcp"],
        "disabled": false
      },
      "sourcegraph": {
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/.venv/bin/sourcegraph-mcp"],
        "environment": {
          "SRC_ENDPOINT": "{env:SRC_ENDPOINT}",
          "SRC_ACCESS_TOKEN": "{env:SRC_ACCESS_TOKEN}"
        },
        "disabled": true
      }
    }
  },
  "agents": {
    "orchestrator": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "analyst": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    // Dedicated primaries replace the built-ins: disabled removes them from
    // the agent list and the TUI picker (opencode 2.3.2).
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "reviewer": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "sidekick": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "providers": {
    // gateway only accepts text + image_url; v2 PR #50933 lowers PDFs to type:"file" parts; pinning capabilities.input converts unsupported media to a text placeholder.
    "opencode-go": {
      "models": {
        "glm-5.3-flash": {
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          // gateway rejects native reasoning_effort on this route; null strips the wire param so upstream applies its own default effort
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": null } },
            { "id": "high", "settings": { "reasoningEffort": null } },
            { "id": "max", "settings": { "reasoningEffort": null } }
          ]
        },
        "deepseek-v4.1-flash": {
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          // unlike glm-5.3-flash, this route accepts native reasoning_effort, so variants set it directly
          "variants": [
            { "id": "max", "settings": { "reasoningEffort": "max" } },
            { "id": "none", "settings": { "reasoningEffort": "none" } }
          ]
        },
        "gpt-5.6-luna": {
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "mimo-v2.6-flash": {
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "neuralwatt": {
      "models": {
        "glm-5.2": {
          "variants": [
            { "id": "high", "body": { "reasoningEffort": "high" } },
            { "id": "max", "body": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
    "Amenable Thor 1": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Amenable Thor 1",
      "settings": {
        "baseURL": "{file:secrets/lan_base_url}",
        "apiKey": "{file:secrets/lan_api_key}"
      },
      "models": {
        "unsloth/Qwen3.8-27B-NVFP4": {
          "name": "Qwen3.8 27B"
        },
        "qwen38-flash-next": {
          "name": "qwen38-flash-next",
          "limit": { "context": 250000 },
          "variants": [
            { "id": "xhigh", "body": { "reasoningEffort": "xhigh" } },
            { "id": "medium", "body": { "reasoningEffort": "medium" } },
            { "id": "low", "body": { "reasoningEffort": "low" } }
          ]
        }
      }
    },
    // OpenRouter with zero data retention (ZDR), no data collection, fp8-or-better quantization floor only
    "openrouter": {
      "body": {
        "provider": { "zdr": true, "data_collection": "deny", "quantizations": ["fp8", "fp16", "bf16", "fp32"] }
      }
    }
  }
}
