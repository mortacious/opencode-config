#!/usr/bin/env bash
# oc - opencode profile launcher.
# Launches opencode under a profile overlay (profiles/<name>/opencode.jsonc)
# by setting OPENCODE_CONFIG (opencode deep-merges the overlay on top of the
# base config). Also manages profiles and installs external project-local
# bundles (e.g. agentic-vault).
set -euo pipefail

# Resolve paths. Works in the dev repo (bin/oc next to profiles/) and when
# deployed to ~/.config/opencode/bin/oc (symlinked onto PATH from install.sh).
SCRIPT_PATH="$(readlink -f "$0")"
BIN_DIR="$(dirname "$SCRIPT_PATH")"
CONFIG_DIR="$(dirname "$BIN_DIR")"
PROFILES_DIR="$CONFIG_DIR/profiles"
ACTIVE_FILE="$CONFIG_DIR/.active-profile"

# Bundle lookup table (extend with new bundles here).
BUNDLE_URL=""
resolve_bundle() {
  local bundle="${1:-}"
  case "$bundle" in
    agentic-vault)
      BUNDLE_URL="https://github.com/mortacious/agentic-vault.git"
      ;;
    *)
      echo "Unknown bundle: $bundle" >&2
      exit 1
      ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: oc [profile] [args...]        Launch opencode with a profile (default: 'default')
       oc profile list                List profiles
       oc profile current             Print the effective active profile name
       oc profile switch [--global] <name>
                                      Set the profile for this directory;
                                      --global sets the machine-wide fallback
       oc profile add <name> [--clone <src>] [--swap-model "<provider/model>"]
       oc profile delete <name>       Delete a profile (refuses 'default')
       oc profile rename <old> <new>  Rename a profile (refuses 'default')
       oc profile install <bundle> <target-dir>
       oc completion <shell>          Emit a shell completion script (fish, bash, zsh)
EOF
}

# Shared state file <CONFIG_DIR>/.active-profile (format v1). Tab-separated
# records, one per line:
#   global\t<name>              machine-wide fallback record (optional)
#   location\t<absDir>\t<name>  per-directory record (precedence over global)
# A legacy single-line file with NO tab is read as the global record. A location
# record may hold the literal name "default", which OVERRIDES the global
# fallback (an explicit per-directory default). Missing/empty file -> no
# records. Structurally unparseable lines are ignored. This is the same file
# and format the profile-switcher plugin reads and writes.

# Physical (symlink-resolved) spelling of a directory, falling back to the raw
# value when it cannot be resolved.
active_canonical_dir() {
  local dir="${1:-}"
  ( cd "$dir" 2>/dev/null && pwd -P ) || printf '%s' "$dir"
  return 0
}

# Normalize the raw file content (ACTIVE_RAW) into v1 records on stdout.
# Names are not validated here; resolution filters them (active_usable_name).
active_parse() {
  if [ -z "${ACTIVE_RAW:-}" ]; then
    return 0
  fi
  if [[ "$ACTIVE_RAW" != *$'\t'* ]]; then
    # Legacy single-line global form.
    local legacy="$ACTIVE_RAW"
    legacy="${legacy#"${legacy%%[![:space:]]*}"}"
    legacy="${legacy%"${legacy##*[![:space:]]}"}"
    if [ -n "$legacy" ]; then
      printf 'global\t%s\n' "$legacy"
    fi
    return 0
  fi
  printf '%s\n' "$ACTIVE_RAW" | awk -F'\t' '
    {
      line = $0
      sub(/\r$/, "", line)
      gsub(/^[ \t]+/, "", line)
      gsub(/[ \t]+$/, "", line)
      if (line == "") next
      n = split(line, f, "\t")
      if (f[1] == "global" && n == 2) { print "global\t" f[2]; next }
      if (f[1] == "location" && n == 3 && f[2] != "") {
        print "location\t" f[2] "\t" f[3]; next
      }
    }
  '
  return 0
}

# Read the state file ONCE into ACTIVE_RAW, then normalize into ACTIVE_RECORDS
# (one v1 record per line). Missing/empty/unreadable -> both empty.
read_active_state() {
  ACTIVE_RAW=""
  ACTIVE_RECORDS=""
  if [ -f "$ACTIVE_FILE" ] && [ -r "$ACTIVE_FILE" ] && [ -s "$ACTIVE_FILE" ]; then
    ACTIVE_RAW="$(cat "$ACTIVE_FILE")"
    ACTIVE_RECORDS="$(active_parse)"
  fi
  return 0
}

# A usable record name: the literal "default", or a safe single path segment
# naming an existing profile overlay. Mirrors the plugin's validation.
active_usable_name() {
  local name="${1:-}"
  [ -n "$name" ] || return 1
  case "$name" in
    .|..) return 1 ;;
    */*|*\\*) return 1 ;;
  esac
  if [ "$name" = "default" ]; then
    return 0
  fi
  [ -f "$PROFILES_DIR/$name/opencode.jsonc" ]
}

# Effective global record: the last usable "global" record, or nothing.
active_get_global() {
  local result=""
  local scope value rest
  while IFS=$'\t' read -r scope value rest; do
    [ "$scope" = "global" ] || continue
    if active_usable_name "$value"; then
      result="$value"
    fi
  done <<< "${ACTIVE_RECORDS:-}"
  if [ -n "$result" ]; then
    printf '%s\n' "$result"
  fi
  return 0
}

# Effective per-directory record for $PWD: canonical (physical) path matches
# win over raw $PWD matches; later records win over earlier ones. Nothing when
# no usable record exists.
active_get_location() {
  local canonical raw
  canonical="$(active_canonical_dir "$PWD")"
  raw="$PWD"
  local canon_name="" canon_hit=0 raw_name="" raw_hit=0
  local scope dir value
  while IFS=$'\t' read -r scope dir value; do
    [ "$scope" = "location" ] || continue
    active_usable_name "$value" || continue
    if [ "$dir" = "$canonical" ]; then
      canon_name="$value"
      canon_hit=1
    elif [ "$dir" = "$raw" ]; then
      raw_name="$value"
      raw_hit=1
    fi
  done <<< "${ACTIVE_RECORDS:-}"
  if [ "$canon_hit" = 1 ]; then
    printf '%s\n' "$canon_name"
  elif [ "$raw_hit" = 1 ]; then
    printf '%s\n' "$raw_name"
  fi
  return 0
}

# Write projected content, or delete the file when there is nothing to persist.
# Atomic-ish: a temp file in CONFIG_DIR, then mv over $ACTIVE_FILE.
active_write_content() {
  local content="$1"
  if [ -z "$content" ]; then
    rm -f "$ACTIVE_FILE"
    return 0
  fi
  local tmp
  tmp="$(mktemp "$CONFIG_DIR/.active-profile.XXXXXX")"
  printf '%s' "$content" > "$tmp"
  mv "$tmp" "$ACTIVE_FILE"
  return 0
}

profile_list() {
  if [ ! -d "$PROFILES_DIR" ]; then
    echo "No profiles directory at $PROFILES_DIR"
    exit 0
  fi
  # Effective active profile for the current directory (see resolve_profile).
  local active
  active="$(profile_current)"
  local overlay name
  for overlay in "$PROFILES_DIR"/*/opencode.jsonc; do
    if [ -f "$overlay" ]; then
      name="$(basename "$(dirname "$overlay")")"
      if [ "$name" = "$active" ]; then
        echo "* $name"
      else
        echo "  $name"
      fi
    fi
  done
}

profile_switch() {
  # Default scope: this directory (canonical location record). --global writes
  # the machine-wide fallback record instead (legacy semantics). The flag is
  # recognized at any position among the subcommand args; the only other token
  # allowed is the single profile name, so extras are rejected.
  local scope="location"
  local name=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --global)
        scope="global"
        ;;
      *)
        if [ -n "$name" ]; then
          echo "Unexpected argument: $arg" >&2
          usage >&2
          exit 1
        fi
        name="$arg"
        ;;
    esac
  done
  if [ -z "$name" ]; then
    usage >&2
    exit 1
  fi
  if [ ! -f "$PROFILES_DIR/$name/opencode.jsonc" ]; then
    echo "No such profile: $name (run 'oc profile list')" >&2
    exit 1
  fi
  read_active_state
  local canonical raw
  canonical="$(active_canonical_dir "$PWD")"
  raw="$PWD"
  # Preserve unrelated records; replace this directory's record (or the global
  # record for --global). Later output: global first, then locations.
  local global="" have_global=0 locations=""
  local rscope a b
  while IFS=$'\t' read -r rscope a b; do
    [ -n "$rscope" ] || continue
    case "$rscope" in
      global)
        if [ "$scope" = "global" ]; then
          continue
        fi
        global="$a"
        have_global=1
        ;;
      location)
        if [ "$scope" = "location" ] && { [ "$a" = "$canonical" ] || [ "$a" = "$raw" ]; }; then
          continue
        fi
        locations="${locations}location"$'\t'"$a"$'\t'"$b"$'\n'
        ;;
    esac
  done <<< "${ACTIVE_RECORDS:-}"
  if [ "$scope" = "global" ]; then
    global="$name"
    have_global=1
  else
    locations="${locations}location"$'\t'"$canonical"$'\t'"$name"$'\n'
  fi
  local content=""
  if [ "$have_global" = 1 ] && [ -n "$global" ]; then
    content="global"$'\t'"$global"$'\n'
  fi
  content="${content}${locations}"
  active_write_content "$content"
  if [ "$scope" = "global" ]; then
    echo "Global profile: $name"
  else
    echo "Active profile: $name"
  fi
}

profile_add() {
  local name="$1"
  shift
  local src=""
  local model=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --clone)
        if [ $# -lt 2 ]; then
          usage >&2
          exit 1
        fi
        src="$2"
        shift 2
        ;;
      --swap-model)
        if [ $# -lt 2 ]; then
          usage >&2
          exit 1
        fi
        model="$2"
        shift 2
        ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
  done

  if [ -e "$PROFILES_DIR/$name" ]; then
    echo "Profile already exists: $name" >&2
    exit 1
  fi
  if [ -n "$model" ] && ! command -v jq >/dev/null 2>&1; then
    echo "jq is required for --swap-model" >&2
    exit 1
  fi

  mkdir -p "$PROFILES_DIR/$name"
  local overlay="$PROFILES_DIR/$name/opencode.jsonc"
  if [ -n "$src" ] && [ -f "$PROFILES_DIR/$src/opencode.jsonc" ]; then
    cp "$PROFILES_DIR/$src/opencode.jsonc" "$overlay"
  else
    cat > "$overlay" <<'PROFILE_EOF'
{
  "$schema": "https://opencode.ai/config.json"
}
PROFILE_EOF
  fi

  if [ -n "$model" ]; then
    # Rewrite: every agents.*.model (v2; falls back to agent.* on v1 overlays)
    # + small_model -> new id; strip agent variants.
    # jq parses strict JSON only, so drop full-line // comments (jsonc) first.
    sed -E 's|^[[:space:]]*//.*$||' "$overlay" > "$overlay.tmp"
    jq --arg model "$model" '
      (if .agents then .agents |= with_entries(.value |= (del(.variant) | .model = $model))
       elif .agent then .agent |= with_entries(.value |= (del(.variant) | .model = $model))
       else . end)
      | .small_model = $model
    ' "$overlay.tmp" > "$overlay"
    rm -f "$overlay.tmp"
  fi

  # Both the heredoc seed and jq output end with a trailing newline.
  echo "Created profile: $name at $overlay"
}

profile_current() {
  # Effective active profile for the current directory, mirroring
  # resolve_profile precedence WITHOUT an explicit positional arg:
  # OC_PROFILE > per-directory record > global record (or legacy single-line)
  # > literal "default". Prints just the name.
  if [ -n "${OC_PROFILE:-}" ] && [ -f "$PROFILES_DIR/$OC_PROFILE/opencode.jsonc" ]; then
    echo "$OC_PROFILE"
    return 0
  fi
  read_active_state
  local loc
  loc="$(active_get_location)"
  if [ -n "$loc" ]; then
    echo "$loc"
    return 0
  fi
  local glob
  glob="$(active_get_global)"
  if [ -n "$glob" ]; then
    echo "$glob"
    return 0
  fi
  echo "default"
}

profile_delete() {
  local name="$1"
  if [ "$name" = "default" ]; then
    echo "Refusing to delete the 'default' profile (it is the fallback)." >&2
    exit 1
  fi
  if [ ! -d "$PROFILES_DIR/$name" ]; then
    echo "No such profile: $name (run 'oc profile list')" >&2
    exit 1
  fi
  rm -rf "$PROFILES_DIR/$name"
  # Scrub EVERY state record (global or per-directory) naming the deleted
  # profile; delete the file when nothing remains.
  read_active_state
  local content=""
  local rscope a b
  while IFS=$'\t' read -r rscope a b; do
    [ -n "$rscope" ] || continue
    case "$rscope" in
      global)
        if [ "$a" = "$name" ]; then
          continue
        fi
        content="${content}global"$'\t'"$a"$'\n'
        ;;
      location)
        if [ "$b" = "$name" ]; then
          continue
        fi
        content="${content}location"$'\t'"$a"$'\t'"$b"$'\n'
        ;;
    esac
  done <<< "${ACTIVE_RECORDS:-}"
  active_write_content "$content"
  echo "Deleted profile: $name"
}

profile_rename() {
  local old="$1"
  local new="$2"
  if [ "$old" = "default" ]; then
    echo "Refusing to rename the 'default' profile." >&2
    exit 1
  fi
  if [ ! -d "$PROFILES_DIR/$old" ]; then
    echo "No such profile: $old (run 'oc profile list')" >&2
    exit 1
  fi
  if [ -e "$PROFILES_DIR/$new" ]; then
    echo "Profile already exists: $new" >&2
    exit 1
  fi
  mv "$PROFILES_DIR/$old" "$PROFILES_DIR/$new"
  # Rewrite EVERY state record (global or per-directory) naming the old profile.
  read_active_state
  if [ -n "$ACTIVE_RECORDS" ]; then
    local content=""
    local rscope a b
    while IFS=$'\t' read -r rscope a b; do
      [ -n "$rscope" ] || continue
      case "$rscope" in
        global)
          if [ "$a" = "$old" ]; then
            a="$new"
          fi
          content="${content}global"$'\t'"$a"$'\n'
          ;;
        location)
          if [ "$b" = "$old" ]; then
            b="$new"
          fi
          content="${content}location"$'\t'"$a"$'\t'"$b"$'\n'
          ;;
      esac
    done <<< "$ACTIVE_RECORDS"
    active_write_content "$content"
  fi
  echo "Renamed profile: $old -> $new"
}

profile_install() {
  local bundle="$1"
  local target_dir="$2"
  BUNDLE_URL=""
  resolve_bundle "$bundle"
  if [ ! -d "$target_dir" ]; then
    echo "Target dir does not exist: $target_dir" >&2
    exit 1
  fi
  local dest="$target_dir/.agentic-vault"
  if [ -d "$dest" ]; then
    echo "Note: $dest already exists; skipping clone."
  else
    git clone "$BUNDLE_URL" "$dest"
  fi
  # Project-local install mirrors the bundle's own setup model - the global
  # profile system does NOT carry the bundle's agents/skills/knowledge; only
  # this launcher copies them per-target.
  bash "$dest/setup.sh"
  echo "Installed $bundle into $target_dir (project-local .opencode/)."
}

profile_cmd() {
  if [ $# -lt 1 ]; then
    usage >&2
    exit 1
  fi
  local sub="$1"
  shift
  case "$sub" in
    list)
      profile_list
      ;;
    switch)
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      profile_switch "$@"
      ;;
    add)
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      profile_add "$@"
      ;;
    current)
      profile_current
      ;;
    delete)
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      profile_delete "$1"
      ;;
    install)
      if [ $# -lt 2 ]; then
        usage >&2
        exit 1
      fi
      profile_install "$1" "$2"
      ;;
    rename)
      if [ $# -lt 2 ]; then
        usage >&2
        exit 1
      fi
      profile_rename "$1" "$2"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

completion_cmd() {
  local shell="${1:-}"
  if [ -z "$shell" ]; then
    echo "Usage: oc completion <shell>    (supported: fish, bash, zsh)" >&2
    exit 1
  fi
  case "$shell" in
    fish)
      # Emit a fish completion script for the oc wrapper's own subcommands.
      # Fish autoloads this via its embedded 'completions/oc.fish' default
      # (= 'oc completion fish | source'), so a valid script here replaces
      # the broken bash that opencode would emit if 'completion' fell through
      # to the catch-all and got forwarded.
      cat <<'FISH_EOF'
# oc completion - generated by 'oc completion fish'.
# Completions for the oc profile launcher (NOT OpenShift oc).

function __oc_profiles
    # Resolve the real bin/oc path even if invoked via symlink, then walk up
    # to the config dir to find profiles/.
    set -l oc_path (command -v oc 2>/dev/null)
    if test -z "$oc_path"
        return
    end
    set -l real_path (readlink -f $oc_path)
    set -l bin_dir (dirname $real_path)
    set -l config_dir (dirname $bin_dir)
    set -l profiles_dir "$config_dir/profiles"
    if test -d "$profiles_dir"
        for f in $profiles_dir/*/opencode.jsonc
            if test -f $f
                basename (dirname $f)
            end
        end
    end
end

# Suppress filename completion for positional args by default.
complete -c oc -f

# Top-level first arg: 'profile' subcommand, a profile name (default action),
# or --help/-h.
complete -c oc -n "__fish_use_subcommand" -a "profile" -d "Manage profiles"
complete -c oc -n "__fish_use_subcommand" -a "(__oc_profiles)" -d "Launch opencode under this profile"
complete -c oc -n "__fish_use_subcommand" -l help -s h -d "Show usage"

# 'profile' subcommand: list, switch, add, install.
complete -c oc -n "__fish_seen_subcommand_from profile" -a "list" -d "List profiles"
complete -c oc -n "__fish_seen_subcommand_from profile" -a "current" -d "Print active profile"
complete -c oc -n "__fish_seen_subcommand_from profile" -a "switch" -d "Set profile for this directory (or --global fallback)"
complete -c oc -n "__fish_seen_subcommand_from profile" -a "add" -d "Create a new profile"

# 'profile switch [--global] <name>': complete existing profile names.
complete -c oc -n "__fish_seen_subcommand_from switch" -l global -d "Set the machine-wide fallback profile"
complete -c oc -n "__fish_seen_subcommand_from switch" -a "(__oc_profiles)" -d "Profile name"
complete -c oc -n "__fish_seen_subcommand_from profile" -a "delete" -d "Delete a profile"
complete -c oc -n "__fish_seen_subcommand_from profile" -a "rename" -d "Rename a profile"
complete -c oc -n "__fish_seen_subcommand_from profile" -a "install" -d "Install an external bundle"

# 'profile delete <name>': complete existing profile names.
complete -c oc -n "__fish_seen_subcommand_from delete" -a "(__oc_profiles)" -d "Profile to delete"

# 'profile rename <old> <new>': old from existing, new is free-form.
complete -c oc -n "__fish_seen_subcommand_from rename" -a "(__oc_profiles)" -d "Profile to rename"

# 'profile add <name> [--clone <src>] [--swap-model "<provider/model>"]'.
# --clone takes an existing profile name; --swap-model takes a free-form model id.
complete -c oc -n "__fish_seen_subcommand_from add" -l clone -d "Fork from existing profile" -r -a "(__oc_profiles)"
complete -c oc -n "__fish_seen_subcommand_from add" -l swap-model -d "Rewrite every agent model + small_model to this id" -r

# 'profile install <bundle> <target-dir>': complete known bundle names, then a directory.
complete -c oc -n "__fish_seen_subcommand_from install" -a "agentic-vault" -d "Install bundle"
FISH_EOF
      ;;
    bash|zsh)
      # opencode's own 'completion' subcommand already emits a bash/yargs script
      # that hardcodes opencode's subcommand tree - it does not describe oc's
      # surface and would be misleading. Emit a minimal stub rather than forward.
      echo "# oc completion for $shell: not implemented (only fish is supported)."
      echo "# Use 'oc --help' to see available subcommands."
      exit 0
      ;;
    *)
      echo "oc completion: unsupported shell '$shell' (supported: fish, bash, zsh)" >&2
      exit 1
      ;;
  esac
}

resolve_profile() {
  local name="${1:-}"
  # 1. Explicit first arg naming a profile.
  if [ -n "$name" ] && [ -f "$PROFILES_DIR/$name/opencode.jsonc" ]; then
    echo "$name"
    return 0
  fi
  # 2. OC_PROFILE env var.
  if [ -n "${OC_PROFILE:-}" ] && [ -f "$PROFILES_DIR/$OC_PROFILE/opencode.jsonc" ]; then
    echo "$OC_PROFILE"
    return 0
  fi
  # 3. Per-directory record for the current directory (a "default" record
  #    counts as present and overrides the global fallback).
  read_active_state
  local loc
  loc="$(active_get_location)"
  if [ -n "$loc" ]; then
    echo "$loc"
    return 0
  fi
  # 4. Global record (or legacy single-line value).
  local glob
  glob="$(active_get_global)"
  if [ -n "$glob" ]; then
    echo "$glob"
    return 0
  fi
  # 5. Fallback.
  echo "default"
}

main() {
  case "${1:-}" in
    profile)
      shift
      profile_cmd "$@"
      ;;
    completion)
      shift
      completion_cmd "$@"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      local profile
      profile="$(resolve_profile "${1:-}")"
      if [ -n "${1:-}" ] && [ -f "$PROFILES_DIR/$1/opencode.jsonc" ]; then
        shift
      fi
      if ! command -v opencode >/dev/null 2>&1; then
        echo "opencode not found on PATH" >&2
        exit 1
      fi
      export OPENCODE_CONFIG="$PROFILES_DIR/$profile/opencode.jsonc"
      echo "Using profile: $profile" >&2
      exec opencode "$@"
      ;;
  esac
}

main "$@"
