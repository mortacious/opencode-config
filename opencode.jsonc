{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode-go/deepseek-v4-flash",
  "subagent_depth": 2,
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "caveman-opencode-plugin@latest"
  ],
  "lsp": true,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "model": "neuralwatt/glm-5.2",
      "variant": "high"
    },
    "plan": {
      "model": "neuralwatt/glm-5.2",
      "variant": "high"
    },
    "sparring": {
      "model": "neuralwatt/glm-5.2",
      "variant": "high"
    },
    "reviewer": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "sidekick": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "research": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "design": {
      "model": "opencode/gpt-5.6-luna",
      "variant": "max"
    }
  },
  "provider": {
    "neuralwatt": {
      "models": {
        "glm-5.2": {
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "Amenable Thor 1": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "Amenable Thor 1",
        "options": {
          "baseURL": "http://10.249.3.0:3000/api/v1",
          "apiKey": "sk-1160d220edc64d189934232ad4ff77b7"
      },
      "models": {
        "sakamakismile/Qwen3.6-27B-NVFP4": {
          "name": "Qwen3.6 27B"
        }
      }
    }
  }
}
