#!/usr/bin/env bash
# opencode-profile - manage opencode profile overlays (profiles/<name>/).
# This is a MANAGEMENT tool only: it never launches opencode and installs
# nothing. The active profile is applied when opencode starts - the
# profile-switcher plugin resolves it (per-directory record, global fallback,
# OC_PROFILE), or you start a one-off with:
#   OC_PROFILE=<name> opencode
set -euo pipefail

# Resolve paths. Works in the dev repo (bin/opencode-profile next to
# profiles/) and when deployed to ~/.config/opencode/bin/opencode-profile
# (symlinked onto PATH from install.sh).
SCRIPT_PATH="$(readlink -f "$0")"
BIN_DIR="$(dirname "$SCRIPT_PATH")"
CONFIG_DIR="$(dirname "$BIN_DIR")"
PROFILES_DIR="$CONFIG_DIR/profiles"
ACTIVE_FILE="$CONFIG_DIR/.active-profile"

usage() {
  cat <<'EOF'
Usage: opencode-profile list                List profiles
       opencode-profile current             Print the effective active profile name
       opencode-profile switch [--global] <name>
                                            Set the profile for this directory;
                                            --global sets the machine-wide fallback
       opencode-profile add <name> [--clone <src>] [--swap-model "<provider>/<model>[#variant]"]
                                            Create a profile
       opencode-profile delete <name>       Delete a profile (refuses 'default')
       opencode-profile rename <old> <new>  Rename a profile (refuses 'default')
       opencode-profile --help              Show this help

This tool only manages profile files and the .active-profile state. A profile
is applied by launching plain 'opencode' (the profile-switcher plugin reads the
state), or one-off with: OC_PROFILE=<name> opencode
EOF
}

# Shared state file <CONFIG_DIR>/.active-profile (format v1). Tab-separated
# records, one per line:
#   global\t<name>              machine-wide fallback record (optional)
#   location\t<absDir>\t<name>  per-directory record (precedence over global)
# A legacy single-line file with NO tab is read as the global record. A location
# record may hold the literal name "default", which OVERRIDES the global
# fallback (an explicit per-directory default). Missing/empty file -> no
# records. Structurally unparseable lines are ignored. This is the same file
# and format the profile-switcher plugin reads and writes.

# A profile name must be a single path segment: never empty, ".", "..", or a
# path separator. Mirrors the shared isSafeProfileName
# (plugin-src/shared/active-profile.js) so a name that reaches a path is always
# exactly one directory under profiles/.
safe_name() {
  local name="${1:-}"
  if [ -z "$name" ] || [ "$name" = "." ] || [ "$name" = ".." ]; then
    return 1
  fi
  case "$name" in
    */*|*\\*) return 1 ;;
  esac
  return 0
}

# Refuse an unsafe name before it reaches any path (mkdir, rm, mv, or a state
# write).
require_safe_name() {
  local name="${1:-}"
  if ! safe_name "$name"; then
    echo "Invalid profile name: ${name:-<empty>}" >&2
    exit 1
  fi
}

# Physical (symlink-resolved) spelling of a directory, falling back to the raw
# value when it cannot be resolved.
active_canonical_dir() {
  local dir="${1:-}"
  ( cd "$dir" 2>/dev/null && pwd -P ) || printf '%s' "$dir"
  return 0
}

# Normalize the raw file content (ACTIVE_RAW) into v1 records on stdout.
# Names are not validated here; resolution filters them (active_usable_name).
active_parse() {
  if [ -z "${ACTIVE_RAW:-}" ]; then
    return 0
  fi
  if [[ "$ACTIVE_RAW" != *$'\t'* ]]; then
    # Legacy single-line global form.
    local legacy="$ACTIVE_RAW"
    legacy="${legacy#"${legacy%%[![:space:]]*}"}"
    legacy="${legacy%"${legacy##*[![:space:]]}"}"
    if [ -n "$legacy" ]; then
      printf 'global\t%s\n' "$legacy"
    fi
    return 0
  fi
  printf '%s\n' "$ACTIVE_RAW" | awk -F'\t' '
    {
      line = $0
      sub(/\r$/, "", line)
      gsub(/^[ \t]+/, "", line)
      gsub(/[ \t]+$/, "", line)
      if (line == "") next
      n = split(line, f, "\t")
      if (f[1] == "global" && n == 2) { print "global\t" f[2]; next }
      if (f[1] == "location" && n == 3 && f[2] != "") {
        print "location\t" f[2] "\t" f[3]; next
      }
    }
  '
  return 0
}

# Read the state file ONCE into ACTIVE_RAW, then normalize into ACTIVE_RECORDS
# (one v1 record per line). Missing/empty/unreadable -> both empty.
read_active_state() {
  ACTIVE_RAW=""
  ACTIVE_RECORDS=""
  if [ -f "$ACTIVE_FILE" ] && [ -r "$ACTIVE_FILE" ] && [ -s "$ACTIVE_FILE" ]; then
    ACTIVE_RAW="$(cat "$ACTIVE_FILE")"
    ACTIVE_RECORDS="$(active_parse)"
  fi
  return 0
}

# A usable record name: the literal "default", or a safe single path segment
# naming an existing profile overlay. Mirrors the plugin's validation.
active_usable_name() {
  local name="${1:-}"
  [ -n "$name" ] || return 1
  case "$name" in
    .|..) return 1 ;;
    */*|*\\*) return 1 ;;
  esac
  if [ "$name" = "default" ]; then
    return 0
  fi
  [ -f "$PROFILES_DIR/$name/opencode.jsonc" ]
}

# Effective global record: the last usable "global" record, or nothing.
active_get_global() {
  local result=""
  local scope value rest
  while IFS=$'\t' read -r scope value rest; do
    [ "$scope" = "global" ] || continue
    if active_usable_name "$value"; then
      result="$value"
    fi
  done <<< "${ACTIVE_RECORDS:-}"
  if [ -n "$result" ]; then
    printf '%s\n' "$result"
  fi
  return 0
}

# Effective per-directory record for $PWD: canonical (physical) path matches
# win over raw $PWD matches; later records win over earlier ones. Nothing when
# no usable record exists.
active_get_location() {
  local canonical raw
  canonical="$(active_canonical_dir "$PWD")"
  raw="$PWD"
  local canon_name="" canon_hit=0 raw_name="" raw_hit=0
  local scope dir value
  while IFS=$'\t' read -r scope dir value; do
    [ "$scope" = "location" ] || continue
    active_usable_name "$value" || continue
    if [ "$dir" = "$canonical" ]; then
      canon_name="$value"
      canon_hit=1
    elif [ "$dir" = "$raw" ]; then
      raw_name="$value"
      raw_hit=1
    fi
  done <<< "${ACTIVE_RECORDS:-}"
  if [ "$canon_hit" = 1 ]; then
    printf '%s\n' "$canon_name"
  elif [ "$raw_hit" = 1 ]; then
    printf '%s\n' "$raw_name"
  fi
  return 0
}

# Write projected content, or delete the file when there is nothing to persist.
# Atomic-ish: a temp file in CONFIG_DIR, then mv over $ACTIVE_FILE.
active_write_content() {
  local content="$1"
  if [ -z "$content" ]; then
    rm -f "$ACTIVE_FILE"
    return 0
  fi
  local tmp
  tmp="$(mktemp "$CONFIG_DIR/.active-profile.XXXXXX")"
  printf '%s' "$content" > "$tmp"
  mv "$tmp" "$ACTIVE_FILE"
  return 0
}

profile_list() {
  if [ ! -d "$PROFILES_DIR" ]; then
    echo "No profiles directory at $PROFILES_DIR"
    exit 0
  fi
  # Effective active profile for the current directory (see profile_current).
  local active
  active="$(profile_current)"
  local overlay name
  for overlay in "$PROFILES_DIR"/*/opencode.jsonc; do
    if [ -f "$overlay" ]; then
      name="$(basename "$(dirname "$overlay")")"
      if [ "$name" = "$active" ]; then
        echo "* $name"
      else
        echo "  $name"
      fi
    fi
  done
}

# Switch-time tier sync. A tier-managed profile (profiles/<name>/tiers.json)
# has a GENERATED overlay, so regenerate it from the authored tiers before a
# switch applies - the same sync the launcher used to run. Non-tier profiles
# have nothing to sync. The script's own stderr carries the error output.
sync_tiers_for_switch() {
  local name="$1"
  if [ ! -f "$PROFILES_DIR/$name/tiers.json" ]; then
    return 0
  fi
  if ! node "$CONFIG_DIR/scripts/tiers-sync.mjs" --profile "$name"; then
    echo "Tier sync failed for profile: $name (profile not switched)" >&2
    return 1
  fi
  return 0
}

profile_switch() {
  # Default scope: this directory (canonical location record). --global writes
  # the machine-wide fallback record instead (legacy semantics). The flag is
  # recognized at any position among the subcommand args; the only other token
  # allowed is the single profile name, so extras are rejected.
  local scope="location"
  local name=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --global)
        scope="global"
        ;;
      *)
        if [ -n "$name" ]; then
          echo "Unexpected argument: $arg" >&2
          usage >&2
          exit 1
        fi
        name="$arg"
        ;;
    esac
  done
  if [ -z "$name" ]; then
    usage >&2
    exit 1
  fi
  require_safe_name "$name"
  if [ ! -f "$PROFILES_DIR/$name/opencode.jsonc" ]; then
    echo "No such profile: $name (run 'opencode-profile list')" >&2
    exit 1
  fi
  # Regenerate a tier-managed profile's GENERATED overlay from its authored
  # tiers before the switch applies. Runs before any state write, so a failed
  # sync leaves .active-profile untouched and the switch refused.
  if ! sync_tiers_for_switch "$name"; then
    exit 1
  fi
  read_active_state
  local canonical raw
  canonical="$(active_canonical_dir "$PWD")"
  raw="$PWD"
  # Preserve unrelated records; replace this directory's record (or the global
  # record for --global). Later output: global first, then locations.
  local global="" have_global=0 locations=""
  local rscope a b
  while IFS=$'\t' read -r rscope a b; do
    [ -n "$rscope" ] || continue
    case "$rscope" in
      global)
        if [ "$scope" = "global" ]; then
          continue
        fi
        global="$a"
        have_global=1
        ;;
      location)
        if [ "$scope" = "location" ] && { [ "$a" = "$canonical" ] || [ "$a" = "$raw" ]; }; then
          continue
        fi
        locations="${locations}location"$'\t'"$a"$'\t'"$b"$'\n'
        ;;
    esac
  done <<< "${ACTIVE_RECORDS:-}"
  if [ "$scope" = "global" ]; then
    global="$name"
    have_global=1
  else
    locations="${locations}location"$'\t'"$canonical"$'\t'"$name"$'\n'
  fi
  local content=""
  if [ "$have_global" = 1 ] && [ -n "$global" ]; then
    content="global"$'\t'"$global"$'\n'
  fi
  content="${content}${locations}"
  active_write_content "$content"
  if [ "$scope" = "global" ]; then
    echo "Global profile: $name"
  else
    echo "Active profile: $name"
  fi
}

profile_add() {
  local name="$1"
  shift
  local src=""
  local model=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --clone)
        if [ $# -lt 2 ]; then
          usage >&2
          exit 1
        fi
        src="$2"
        shift 2
        ;;
      --swap-model)
        if [ $# -lt 2 ]; then
          usage >&2
          exit 1
        fi
        model="$2"
        shift 2
        ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
  done

  require_safe_name "$name"
  if [ -n "$src" ]; then
    require_safe_name "$src"
  fi

  if [ -e "$PROFILES_DIR/$name" ]; then
    echo "Profile already exists: $name" >&2
    exit 1
  fi
  if [ -n "$model" ] && ! command -v jq >/dev/null 2>&1; then
    echo "jq is required for --swap-model" >&2
    exit 1
  fi

  mkdir -p "$PROFILES_DIR/$name"
  local overlay="$PROFILES_DIR/$name/opencode.jsonc"
  if [ -n "$src" ] && [ -f "$PROFILES_DIR/$src/opencode.jsonc" ]; then
    cp "$PROFILES_DIR/$src/opencode.jsonc" "$overlay"
    # A tier-managed source makes the clone tier-managed too: copy the
    # authored mapping and regenerate the overlay below from it.
    if [ -f "$PROFILES_DIR/$src/tiers.json" ]; then
      cp "$PROFILES_DIR/$src/tiers.json" "$PROFILES_DIR/$name/tiers.json"
    fi
  else
    cat > "$overlay" <<'PROFILE_EOF'
{
  "$schema": "https://opencode.ai/config.json"
}
PROFILE_EOF
  fi

  if [ -n "$model" ]; then
    if [ -f "$PROFILES_DIR/$name/tiers.json" ]; then
      # Tier-managed profile: retarget every tier entry, then regenerate the
      # overlay from tiers.json. Per-agent pin rewriting no longer applies:
      # the overlay is generated and is never edited directly.
      local tiers="$PROFILES_DIR/$name/tiers.json"
      # tiers.json values are AUTHORED objects ({model, description}); replace
      # only the model, keeping every description and adding a model when a
      # tier has none. Replacing the whole value with a bare string would make
      # the file invalid for tiers-sync.
      if ! jq --arg model "$model" '.tiers |= with_entries(.value |= (.model = $model))' \
        "$tiers" > "$tiers.tmp"; then
        rm -f "$tiers.tmp"
        echo "Failed to rewrite $tiers" >&2
        exit 1
      fi
      mv "$tiers.tmp" "$tiers"
      if ! node "$CONFIG_DIR/scripts/tiers-sync.mjs" --profile "$name"; then
        echo "Tier sync failed for profile: $name" >&2
        exit 1
      fi
    else
      # Rewrite: every agents.*.model (v2; falls back to agent.* on v1 overlays)
      # + small_model -> new id; strip agent variants.
      # jq parses strict JSON only, so drop full-line // comments (jsonc) first.
      sed -E 's|^[[:space:]]*//.*$||' "$overlay" > "$overlay.tmp"
      jq --arg model "$model" '
        (if .agents then .agents |= with_entries(.value |= (del(.variant) | .model = $model))
         elif .agent then .agent |= with_entries(.value |= (del(.variant) | .model = $model))
         else . end)
        | .small_model = $model
      ' "$overlay.tmp" > "$overlay"
      rm -f "$overlay.tmp"
    fi
  elif [ -f "$PROFILES_DIR/$name/tiers.json" ]; then
    # Clone of a tier-managed profile without a swap: regenerate the clone's
    # overlay from its copied tiers.json instead of trusting the source copy.
    if ! node "$CONFIG_DIR/scripts/tiers-sync.mjs" --profile "$name"; then
      echo "Tier sync failed for profile: $name" >&2
      exit 1
    fi
  fi

  # Both the heredoc seed and jq output end with a trailing newline.
  echo "Created profile: $name at $overlay"
}

profile_current() {
  # Effective active profile for the current directory, mirroring the
  # profile-switcher resolution precedence WITHOUT an explicit profile arg:
  # OC_PROFILE > per-directory record > global record (or legacy single-line)
  # > literal "default". Prints just the name.
  if [ -n "${OC_PROFILE:-}" ] && [ -f "$PROFILES_DIR/$OC_PROFILE/opencode.jsonc" ]; then
    echo "$OC_PROFILE"
    return 0
  fi
  read_active_state
  local loc
  loc="$(active_get_location)"
  if [ -n "$loc" ]; then
    echo "$loc"
    return 0
  fi
  local glob
  glob="$(active_get_global)"
  if [ -n "$glob" ]; then
    echo "$glob"
    return 0
  fi
  echo "default"
}

profile_delete() {
  local name="$1"
  require_safe_name "$name"
  if [ "$name" = "default" ]; then
    echo "Refusing to delete the 'default' profile (it is the fallback)." >&2
    exit 1
  fi
  if [ ! -d "$PROFILES_DIR/$name" ]; then
    echo "No such profile: $name (run 'opencode-profile list')" >&2
    exit 1
  fi
  rm -rf "$PROFILES_DIR/$name"
  # Scrub EVERY state record (global or per-directory) naming the deleted
  # profile; delete the file when nothing remains.
  read_active_state
  local content=""
  local rscope a b
  while IFS=$'\t' read -r rscope a b; do
    [ -n "$rscope" ] || continue
    case "$rscope" in
      global)
        if [ "$a" = "$name" ]; then
          continue
        fi
        content="${content}global"$'\t'"$a"$'\n'
        ;;
      location)
        if [ "$b" = "$name" ]; then
          continue
        fi
        content="${content}location"$'\t'"$a"$'\t'"$b"$'\n'
        ;;
    esac
  done <<< "${ACTIVE_RECORDS:-}"
  active_write_content "$content"
  echo "Deleted profile: $name"
}

profile_rename() {
  local old="$1"
  local new="$2"
  require_safe_name "$old"
  require_safe_name "$new"
  if [ "$old" = "default" ]; then
    echo "Refusing to rename the 'default' profile." >&2
    exit 1
  fi
  if [ ! -d "$PROFILES_DIR/$old" ]; then
    echo "No such profile: $old (run 'opencode-profile list')" >&2
    exit 1
  fi
  if [ -e "$PROFILES_DIR/$new" ]; then
    echo "Profile already exists: $new" >&2
    exit 1
  fi
  mv "$PROFILES_DIR/$old" "$PROFILES_DIR/$new"
  # Rewrite EVERY state record (global or per-directory) naming the old profile.
  read_active_state
  if [ -n "$ACTIVE_RECORDS" ]; then
    local content=""
    local rscope a b
    while IFS=$'\t' read -r rscope a b; do
      [ -n "$rscope" ] || continue
      case "$rscope" in
        global)
          if [ "$a" = "$old" ]; then
            a="$new"
          fi
          content="${content}global"$'\t'"$a"$'\n'
          ;;
        location)
          if [ "$b" = "$old" ]; then
            b="$new"
          fi
          content="${content}location"$'\t'"$a"$'\t'"$b"$'\n'
          ;;
      esac
    done <<< "$ACTIVE_RECORDS"
    active_write_content "$content"
  fi
  echo "Renamed profile: $old -> $new"
}

main() {
  case "${1:-}" in
    list)
      profile_list
      ;;
    current)
      profile_current
      ;;
    switch)
      shift
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      profile_switch "$@"
      ;;
    add)
      shift
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      profile_add "$@"
      ;;
    delete)
      shift
      if [ $# -lt 1 ]; then
        usage >&2
        exit 1
      fi
      profile_delete "$1"
      ;;
    rename)
      shift
      if [ $# -lt 2 ]; then
        usage >&2
        exit 1
      fi
      profile_rename "$1" "$2"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      # No launch path: an unknown command (including a bare profile name,
      # which the old launcher forwarded to opencode) is a usage error.
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
