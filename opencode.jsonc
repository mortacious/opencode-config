// OpenCode v2 (branch v2-port)
{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode-go/mimo-v2.6-flash",
  "websearch": { "provider": "exa" },
  "experimental": { "subagent_depth": 2 },
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "./plugin-src/fusion-audit",
    {
      "package": "./plugin-src/fusion-tools",
      "options": {
        "advisor": {
          "enabled": false,
          "model": "opencode-go/deepseek-v4.1-flash",
          "scope": ["build", "plan"],
          "activation": "idle-complex",
          "minStepsTurn": 8,
          "minTurnDeltaChars": 8000,
          "failurePauseMs": 900000
        },
        "fanout": {
          "enabled": true,
          "maxConcurrency": 8,
          "defaultAgent": "worker"
        }
      }
    },
    {
      "package": "./plugin-src/lumo-supervisor",
      "options": {
        "checkoutDir": "~/.config/opencode/lumo-tamer"
      }
    },
    {
      "package": "./plugin-src/profile-switcher",
      "options": {
        "modelFallbacks": {
          "lumo-tamer/lumo-max": "Amenable Thor 1/qwen38-flash-next"
        }
      }
    },
    "./plugin-src/subagent-view"
  ],
  // lsp: dropped in v2 port - not a documented v2 top-level key
  // Auto-allow the shared knowledge dir so agents loading web-search
  // strategy modules via read don't prompt for external_directory access.
  // Scope is narrow: .env (one level up, gitignored) stays blocked.
  "permissions": [ { "action": "external_directory", "resource": "~/.config/opencode/knowledge/**", "effect": "allow" } ],
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false
      },
      "semantic-scholar": {
        "type": "local",
        "command": ["npx", "-y", "@xbghc/semanticscholar-mcp"],
        "environment": { "SEMANTIC_SCHOLAR_API_KEY": "{file:secrets/semantic_scholar_api_key}" },
        "disabled": false
      },
      "arxiv": {
        "type": "local",
        "command": ["npx", "-y", "@cyanheads/arxiv-mcp-server"],
        "disabled": false
      },
      "github": {
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/bin/github-mcp-server", "stdio", "--read-only", "--toolsets", "repos,issues,pull_requests,users"],
        "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:secrets/github_personal_access_token}" },
        "disabled": false
      },
      "dblp": {
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/.venv/bin/mcp-dblp"],
        "disabled": false
      },
      "ddgs": {
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/.venv-ddgs/bin/ddgs", "mcp"],
        "disabled": false
      },
      "sourcegraph": {
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/.venv/bin/sourcegraph-mcp"],
        "environment": {
          "SRC_ENDPOINT": "{env:SRC_ENDPOINT}",
          "SRC_ACCESS_TOKEN": "{env:SRC_ACCESS_TOKEN}"
        },
        "disabled": true
      }
    }
  },
  "agents": {
    "build": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "plan": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "sparring": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "reviewer": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "sidekick": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "research": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "advisor": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "design": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "vision": {
      "model": "opencode-go/gpt-5.6-luna"
    }
  },
  "providers": {
    // gateway only accepts text + image_url; v2 PR #50933 lowers PDFs to type:"file" parts; pinning capabilities.input converts unsupported media to a text placeholder.
    "opencode-go": {
      "models": {
        "glm-5.3-flash": {
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          // gateway rejects native reasoning_effort on this route; null strips the wire param so upstream applies its own default effort
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": null } },
            { "id": "high", "settings": { "reasoningEffort": null } },
            { "id": "max", "settings": { "reasoningEffort": null } }
          ]
        },
        "deepseek-v4.1-flash": {
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.6-luna": {
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "mimo-v2.6-flash": {
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "neuralwatt": {
      "models": {
        "glm-5.2": {
          "variants": [
            { "id": "high", "body": { "reasoningEffort": "high" } },
            { "id": "max", "body": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
    "Amenable Thor 1": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Amenable Thor 1",
      "settings": {
        "baseURL": "http://10.249.3.0:3000/api/v1",
        "apiKey": "sk-1160d220edc64d189934232ad4ff77b7"
      },
      "models": {
        "unsloth/Qwen3.8-27B-NVFP4": {
          "name": "Qwen3.8 27B"
        },
        "qwen38-flash-next": {
          "name": "qwen38-flash-next",
          "variants": [
            { "id": "xhigh", "body": { "reasoningEffort": "xhigh" } },
            { "id": "medium", "body": { "reasoningEffort": "medium" } },
            { "id": "low", "body": { "reasoningEffort": "low" } }
          ]
        }
      }
    }
  }
}
