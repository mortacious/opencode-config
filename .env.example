# opencode research-API MCP keys.
# Copy this file to .env (gitignored) and fill in real values.
# Load it into your shell environment BEFORE launching opencode, e.g. in ~/.zshrc:
#   set -a; source ~/.config/opencode/.env; set +a
# opencode resolves {env:VAR} interpolation for MCP "environment" from its process env.

# Semantic Scholar (optional; raises rate limit from 100 req/5min). https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# GitHub Personal Access Token (recommended; 5000 req/hour REST). https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Sourcegraph (optional; the sourcegraph MCP server is disabled by default).
# The akbad/sourcegraph-mcp server reads SRC_ENDPOINT (required) and SRC_ACCESS_TOKEN (optional).
# Cloud access token starts with sgp_ . https://sourcegraph.com/docs/api
SRC_ENDPOINT=https://sourcegraph.com
SRC_ACCESS_TOKEN=
